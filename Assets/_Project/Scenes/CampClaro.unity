  _entries:
  - Label: "Tirad los f\xF3sforos al muelle y empujadlos entre dos"
    CamperHint: en el muelle
    Kind: 0
    PointCount: 2
    WindowSeconds: 0
    Result: {fileID: 0}
  - Label: Coged los calzoncillos del tendedero y colgadlos en la antena
    CamperHint: en el tendedero
    Kind: 0
    PointCount: 2
    WindowSeconds: 0
    Result: {fileID: 1291487806}
  - Label: "\xA1Bocinazo! Uno en la cabina y otro en el cap\xF3, a la vez"
    CamperHint: en la caravana
    Kind: 0
    PointCount: 2
    WindowSeconds: 5
    Result: {fileID: 0}
  - Label: Apagad la fogata con dos bombas de agua
    CamperHint: en la fogata
    Kind: 1
    PointCount: 0
    WindowSeconds: 0
    Result: {fileID: 0}
  - Label: Armad la estatua explosiva junto a la mesa
    CamperHint: en el comedor
    Kind: 2
    PointCount: 1
    WindowSeconds: 45
    Result: {fileID: 0}
