  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BetterTogether.Match.TravesuraLayout
  _entries:
  - Label: "Llevad los f\xF3sforos al muelle y empujadlos entre dos"
    CamperHint: en el muelle
    Kind: 0
    PointCount: 2
    WindowSeconds: 0
    Result: {fileID: 0}
    DoneSfx: {fileID: 11400000, guid: 9d6c8b4a6c1f56f42b2568e03afaebd6, type: 2}
  - Label: Coged sus calzoncillos del tendedero y colgadlos en la antena
    CamperHint: en el tendedero
    Kind: 0
    PointCount: 2
    WindowSeconds: 0
    Result: {fileID: 2021879204}
    DoneSfx: {fileID: 11400000, guid: 9d6c8b4a6c1f56f42b2568e03afaebd6, type: 2}
  - Label: "\xA1Bocinazo! Uno en la cabina y otro en el cap\xF3, a la vez"
    CamperHint: en la caravana
    Kind: 0
    PointCount: 2
    WindowSeconds: 5
    Result: {fileID: 0}
    DoneSfx: {fileID: 11400000, guid: b8ac7765fb3f8a54d9457457e01cba09, type: 2}
  - Label: Apagad la fogata con dos bombas de agua
    CamperHint: en la fogata
    Kind: 1
    PointCount: 0
    WindowSeconds: 0
    Result: {fileID: 0}
    DoneSfx: {fileID: 11400000, guid: 9d6c8b4a6c1f56f42b2568e03afaebd6, type: 2}
  - Label: Haced que pise una estatua explosiva (H)
    CamperHint: algo que explota
    Kind: 2
    PointCount: 0
    WindowSeconds: 0
    Result: {fileID: 0}
    DoneSfx: {fileID: 11400000, guid: 9d6c8b4a6c1f56f42b2568e03afaebd6, type: 2}
  - Label: 'Tiradle el toldo: soltad los dos postes a la vez'
    CamperHint: en el toldo
    Kind: 0
    PointCount: 2
    WindowSeconds: 5
    Result: {fileID: 2118098988}
    DoneSfx: {fileID: 11400000, guid: 9d6c8b4a6c1f56f42b2568e03afaebd6, type: 2}
  - Label: Robad su bota de la tienda y metedla en la hielera
    CamperHint: en la tienda
    Kind: 0
    PointCount: 2
    WindowSeconds: 0
    Result: {fileID: 467351747}
    DoneSfx: {fileID: 11400000, guid: 9d6c8b4a6c1f56f42b2568e03afaebd6, type: 2}
  _needed: 5
