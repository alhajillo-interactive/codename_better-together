# Normalize line endings: the repo always stores LF.
* text=auto

# Unity YAML: Unity writes these with LF, so keep LF in the working tree too
# (avoids "modified" files that only differ in line endings on Windows).
# text=auto: git still detects binary files (e.g. TerrainData, NavMesh .asset) and never converts them;
# converting a binary file corrupts it.
# merge=unityyamlmerge only takes effect if each machine configures Unity's Smart Merge, e.g.:
#   git config merge.unityyamlmerge.name "Unity SmartMerge"
#   git config merge.unityyamlmerge.driver "'<Unity>/Editor/Data/Tools/UnityYAMLMerge.exe' merge -p %O %B %A %A"
# Without it git falls back to its normal text merge.
*.unity         text=auto eol=lf merge=unityyamlmerge
*.prefab        text=auto eol=lf merge=unityyamlmerge
*.asset         text=auto eol=lf merge=unityyamlmerge
*.meta          text=auto eol=lf merge=unityyamlmerge
